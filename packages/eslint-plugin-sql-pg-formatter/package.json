{
  "name": "@repo/eslint-plugin-sql-pg-formatter",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "dev": "pnpm run clean && tsc --watch"
  },
  "dependencies": {
    "psqlformat": "1.30.0"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1"
  }
}
