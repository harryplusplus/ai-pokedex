{
  "name": "nest-component-scan",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@swc/core": "1.15.8",
    "chokidar": "5.0.0",
    "fast-glob": "3.3.3",
    "piscina": "5.1.4"
  }
}
