{
  "name": "prettier-plugin-pg",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "psqlformat": "1.30.0"
  },
  "devDependencies": {
    "prettier": "3.7.4"
  }
}
