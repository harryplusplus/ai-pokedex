{
  "compilerOptions": {
    // Languages
    "target": "esnext",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,

    // Types
    "strict": true,
    "skipLibCheck": true,

    // Builds
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "incremental": true,
    "removeComments": true,
    "declarationMap": true,
    "declaration": true,
    "sourceMap": true
  }
}
